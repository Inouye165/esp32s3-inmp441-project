# ── PlatformIO ──────────────────────────────────────────────────────────────
firmware/.pio/
firmware/.pioenvs/

# ── Firmware secrets (WiFi credentials — never commit the real file) ─────────
firmware/include/secrets.h
firmware/src_esp32classic/secrets_esp32.h

# ── Node / Server ────────────────────────────────────────────────────────────
server/node_modules/
server/dist/
server/.env            # legacy env file (kept ignored for local compatibility)
server/.env.local      # real local env — use .env.local.example as template
server/recordings/
server/data/           # module registry (runtime-generated)
server/public/uploads/ # module photos (user-uploaded)
!server/public/uploads/.gitkeep

# ── TypeScript build artefacts ───────────────────────────────────────────────
*.js.map
*.d.ts.map

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

# ── Jest / coverage ──────────────────────────────────────────────────────────
coverage/
