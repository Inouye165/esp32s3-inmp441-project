PORT=3000
ESP32_IP=
ESP32_PORT=80

# Network access control (comma-separated WiFi SSIDs)
# Leave empty or comment out to block all networks
# ALLOWED_NETWORKS=YourNetwork1,YourNetwork2

# Unit 1 TCP ingest (ESP32-S3, port 8001)
STREAM_INGEST_ENABLED=true
STREAM_INGEST_PORT=8001

# Unit 2 TCP ingest (Classic ESP32-D0WD, port 8002)
STREAM_INGEST2_ENABLED=true
STREAM_INGEST2_PORT=8002
